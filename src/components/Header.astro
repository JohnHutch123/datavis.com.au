---
import { nav, site } from '../site.config';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.legalName} home`}>
      {/* Light and dark versions of the logo, chosen by the visitor's theme.
          Rebuilt from assets/logo/ by `npm run images`. */}
      <picture>
        <source srcset="/images/logo-dark.png" media="(prefers-color-scheme: dark)" />
        <img src="/images/logo-light.png" alt="Datavis" width="133" height="32" />
      </picture>
    </a>
    <nav class="nav desktop" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <details class="menu">
      <summary aria-label="Menu">Menu</summary>
      <nav class="nav" aria-label="Main (mobile)">
        {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </details>
  </div>
</header>
