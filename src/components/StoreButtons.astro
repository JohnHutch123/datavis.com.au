---
// Plain store buttons. Before launch you can swap these for the official
// badges: https://developer.apple.com/app-store/marketing/guidelines/ and
// https://play.google.com/intl/en_us/badges/ (both have usage rules).
interface Props {
  appStoreUrl?: string;
  playStoreUrl?: string;
  other?: { label: string; url: string }[];
}
const { appStoreUrl, playStoreUrl, other = [] } = Astro.props;
---
{(appStoreUrl || playStoreUrl || other.length > 0) ? (
  <div class="stores">
    {appStoreUrl && (
      <a class="store" href={appStoreUrl} rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.4 2-3.5 2-3.6-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8c-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.6zM14.1 5.6c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3z"/></svg>
        <span><small>Download on the</small><b>App Store</b></span>
      </a>
    )}
    {playStoreUrl && (
      <a class="store" href={playStoreUrl} rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.2 13.5 12l-9.9 9.8c-.4-.2-.6-.6-.6-1.1V3.3c0-.5.2-.9.6-1.1zm11 10.9 2.6 2.6-11.2 6.4 8.6-9zm3.8-3.3 2.6 1.5c.7.4.7 1.4 0 1.8l-2.6 1.5-2.9-2.6 2.9-2.2zM6 1.9l11.2 6.4-2.6 2.6L6 1.9z"/></svg>
        <span><small>Get it on</small><b>Google Play</b></span>
      </a>
    )}
    {other.map((o) => <a class="btn" href={o.url} rel="noopener">{o.label}</a>)}
  </div>
) : (
  <p class="muted">Coming soon to the App Store and Google Play.</p>
)}
