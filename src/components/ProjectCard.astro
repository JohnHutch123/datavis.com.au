---
import type { CollectionEntry } from 'astro:content';
import { projectUrl, statusLabel } from '../lib/content';
interface Props { project: CollectionEntry<'projects'> }
const { project: p } = Astro.props;
---
<a class="card" href={projectUrl(p)}>
  <div class="pills">
    <span class={`pill ${p.data.visibility}`}>{p.data.visibility === 'public' ? 'Open source' : 'Commercial'}</span>
    {p.data.status === 'wip' && <span class="pill wip" title="Work in progress">WIP</span>}
    {p.data.status !== 'active' && p.data.status !== 'wip' && <span class="pill">{statusLabel[p.data.status]}</span>}
    {p.data.draft && <span class="pill">draft</span>}
  </div>
  <h3>{p.data.title}</h3>
  <p>{p.data.summary}</p>
  <span class="more">View project →</span>
</a>
