---
import Base from '../layouts/Base.astro';
import TechBadges from '../components/TechBadges.astro';
import { site } from '../site.config';
---
<Base title="About" description={`About ${site.legalName}: who we are, what we build and how we work.`}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">About</span>
      <h1>About {site.legalName}</h1>
      <p class="lead">An Australian software business building graphics, simulation and engineering software, and the developer tools that make them practical.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <!-- EDIT ME: replace this boilerplate with your own story. -->
      <h2>Who we are</h2>
      <p>
        Datavis has been building visualisation and engineering software for many years, including drill and
        blast tools used in mines and quarries. Today our work spans 3D graphics, physics simulation and
        robotics, motorsport and mining, with a common thread: practical software, written mostly in Delphi
        and Object Pascal, that engineers and developers can put straight to work.
      </p>

      <h2>What we build</h2>
      <ul>
        <li><strong>Graphics:</strong> Vulkan component packages for Delphi (VCL, FireMonkey and SDL2), with commercial extensions for CAD and 3D file formats and interactive editing.</li>
        <li><strong>Simulation and robotics:</strong> MuJoCo physics for Delphi and Free Pascal, and Robot Skills, an open format for sharing robot skills.</li>
        <li><strong>Motorsport:</strong> the Drag Tree reaction-time trainer for iPhone and Android, and a library for RaceBox GPS data loggers.</li>
        <li><strong>Mining:</strong> drill and blast design and management software.</li>
        <li><strong>Documentation and samples</strong> so each project can be picked up and used, not just read.</li>
      </ul>

      <h2>How we work</h2>
      <p>
        We publish the core of our work as open source on GitHub under permissive licences, so anyone can
        learn from it and use it in their own products. Features that take sustained investment are offered
        as commercial PRO packages, which fund the open source work.
      </p>
      <p>
        We use AI coding assistants, including Claude by Anthropic, as part of our development process for
        code review, testing and documentation. Every change is reviewed, built and tested before release.
      </p>

      <h2>Technology</h2>
      <TechBadges items={['delphi', 'pascal', 'freepascal', 'python', 'vulkan', 'pasvulkan', 'mujoco', 'vcl', 'fmx', 'sdl2', 'glsl', 'gltf', 'ios', 'android', 'bluetooth', 'gis', 'postgresql', 'github', 'claude']} />

      <h2>Company details</h2>
      <dl class="kv">
        <dt>Business</dt><dd>{site.legalName}</dd>
        {site.abn && <><dt>ABN</dt><dd>{site.abn}</dd></>}
        <dt>Location</dt><dd>{site.country}</dd>
        <dt>Email</dt><dd><a href={`mailto:${site.email.general}`}>{site.email.general}</a></dd>
        <dt>Sales</dt><dd><a href={`mailto:${site.email.sales}`}>{site.email.sales}</a></dd>
        <dt>Support</dt><dd><a href={`mailto:${site.email.support}`}>{site.email.support}</a></dd>
        <dt>Accounts</dt><dd><a href={`mailto:${site.email.accounts}`}>{site.email.accounts}</a></dd>
        <dt>GitHub</dt><dd><a href={site.github.url} rel="noopener">{site.github.url.replace('https://', '')}</a></dd>
      </dl>
    </div>
  </section>
</Base>
