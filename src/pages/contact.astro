---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
// No server-side form: a static site with mailto links has nothing to spam or
// exploit. If you later want a web form, see README.md ("Adding a contact form").
const topics = [
  { title: 'General enquiries', body: 'Questions about Datavis or our projects.', email: site.email.general, subject: 'Enquiry' },
  { title: 'Licensing and PRO packages', body: 'Pricing, commercial licences and custom work.', email: site.email.general, subject: 'Licensing enquiry' },
  { title: 'App and product support', body: 'Help with one of our apps or packages.', email: site.email.support, subject: 'Support request' },
  { title: 'Privacy', body: 'Questions about your data or a data deletion request.', email: site.email.privacy, subject: 'Privacy request' },
];
const mail = (e: string, s: string) => `mailto:${e}?subject=${encodeURIComponent(s)}`;
---
<Base title="Contact" description={`Contact ${site.legalName} for enquiries, licensing and support.`}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p class="lead">Email is the quickest way to reach us. We aim to reply within {site.supportResponse}.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid">
        {topics.map((t) => (
          <a class="card" href={mail(t.email, t.subject)}>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
            <span class="more">{t.email}</span>
          </a>
        ))}
        <a class="card" href={`${site.github.url}`} rel="noopener">
          <h3>Bug reports</h3>
          <p>Found a bug in an open source project? Open an issue on its GitHub repository.</p>
          <span class="more">GitHub →</span>
        </a>
      </div>
      <hr />
      <dl class="kv">
        <dt>Business</dt><dd>{site.legalName}</dd>
        {site.abn && <><dt>ABN</dt><dd>{site.abn}</dd></>}
        <dt>Location</dt><dd>{site.country}</dd>
      </dl>
    </div>
  </section>
</Base>
