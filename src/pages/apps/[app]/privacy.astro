---
// This page's URL is the "Privacy Policy URL" for App Store Connect and
// Google Play Console: https://www.datavis.com.au/apps/<app>/privacy/
// Keep it in step with the App Privacy answers (Apple) and the Data safety
// form (Google): both stores check that they match.
import Base from '../../../layouts/Base.astro';
import AppHeader from '../../../components/AppHeader.astro';
import { site } from '../../../site.config';
import { getApps, appUrl } from '../../../lib/content';

export async function getStaticPaths() {
  return (await getApps()).map((app) => ({ params: { app: app.id }, props: { app } }));
}
const { app } = Astro.props;
const pv = app.data.privacy;
const updated = pv.updated.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const base = appUrl(app.id);
const yes = (b: boolean) => (b ? 'Yes' : 'No');
---
<Base title={`${app.data.name} privacy policy`} description={`What ${app.data.name} collects and how ${site.legalName} handles it.`}>
  <AppHeader app={app} section="Privacy" />
  <section class="section">
    <div class="wrap prose">
      <p class="muted">Last updated {updated}. This page supplements the <a href="/privacy/">{site.legalName} privacy policy</a>.</p>

      <h2>Summary</h2>
      {pv.collectsData ? (
        <p>{app.data.name} collects only the data listed below, for the purposes listed. We do not sell your data or use it for advertising, and we do not track you across other companies' apps or websites.</p>
      ) : (
        <p><strong>{app.data.name} does not collect any personal data.</strong> Everything you create or enter stays on your device. We do not use analytics, advertising or tracking, and the app does not send your data to us or to anyone else.</p>
      )}

      {pv.data.length > 0 && (
        <>
          <h2>Data the app collects</h2>
          <table>
            <thead><tr><th>Data</th><th>Purpose</th><th>Linked to you</th><th>Shared with third parties</th><th>Optional</th></tr></thead>
            <tbody>
              {pv.data.map((d) => (
                <tr><td>{d.category}</td><td>{d.purpose}</td><td>{yes(d.linkedToUser)}</td><td>{yes(d.shared)}</td><td>{yes(d.optional)}</td></tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {pv.thirdParties.length > 0 && (
        <>
          <h2>Third-party services</h2>
          <p>The app uses these services, which handle data under their own privacy policies:</p>
          <ul>{pv.thirdParties.map((t) => <li><a href={t.policyUrl} rel="noopener">{t.name}</a>: {t.purpose}</li>)}</ul>
        </>
      )}

      <h2>Device permissions</h2>
      <p>If the app asks for a permission (for example camera, photos or files), it is used only for the feature you are using at the time, and you can turn it off at any time in your device settings.</p>

      <h2>Data security and retention</h2>
      <p>{pv.retention ?? 'Data stored by the app stays on your device until you delete it or uninstall the app. Any data sent to us is encrypted in transit and kept only as long as it is needed.'}</p>

      <h2>Deleting your data</h2>
      {pv.accounts ? (
        <p>You can delete your account and its data from within the app, or by following the steps on the <a href={`${base}delete-account/`}>delete your account</a> page.</p>
      ) : (
        <p>Uninstalling the app removes the data it stores on your device. If you have emailed us, you can ask us to delete that correspondence at <a href={`mailto:${site.email.privacy}`}>{site.email.privacy}</a>.</p>
      )}

      <h2>Children</h2>
      <p>{app.data.name} is not directed at children under 13, and we do not knowingly collect personal information from children.</p>

      <h2>Changes</h2>
      <p>If this app's data practices change, we will update this page and the date above before the new version is released.</p>

      <h2>Contact</h2>
      <p>{site.legalName}, {site.country}. Privacy questions: <a href={`mailto:${site.email.privacy}`}>{site.email.privacy}</a>.</p>
    </div>
  </section>
</Base>
