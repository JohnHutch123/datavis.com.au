---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TechBadges from '../../../components/TechBadges.astro';
import { site } from '../../../site.config';
import { project as schemaProject, breadcrumbs } from '../../../lib/schema';
import { getProjects, getDocs, getApps, groupUrl, projectUrl, docUrl, appUrl } from '../../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { group: project.data.group.id, project: project.id },
    props: { project },
  }));
}
const { project: p } = Astro.props;
const group = await getEntry(p.data.group);
const docs = await getDocs(p.id);
const apps = await getApps(p.id);
const siblings = (await getProjects(p.data.group.id)).filter((s) => s.id !== p.id);
const { Content, headings } = await render(p);
const toc = headings.filter((h) => h.depth === 2);
const path = projectUrl(p);
const schema = [
  schemaProject(p, path),
  breadcrumbs([
    { name: 'Projects', path: '/projects/' },
    { name: group?.data.title ?? p.data.group.id, path: groupUrl(p.data.group.id) },
    { name: p.data.title, path },
  ]),
];
---
<Base title={p.data.title} description={p.data.summary} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <div class="crumbs"><a href="/projects/">Projects</a> / <a href={groupUrl(p.data.group.id)}>{group?.data.title}</a> / {p.data.title}</div>
      <div class="pills" style="margin-bottom:1rem">
        <span class={`pill ${p.data.visibility}`}>{p.data.visibility === 'public' ? 'Open source' : 'Commercial · private repository'}</span>
        {p.data.license && <span class="pill">{p.data.license}</span>}
        <span class="pill">{p.data.status}</span>
      </div>
      <h1>{p.data.title}</h1>
      <p class="lead">{p.data.summary}</p>
      <div class="actions">
        {docs[0] && <a class="btn primary" href={docUrl(docs[0])}>Read the docs</a>}
        {p.data.visibility === 'public' && p.data.repo && <a class="btn" href={p.data.repo} rel="noopener">View on GitHub</a>}
        {p.data.visibility === 'private' && (
          <a class="btn" href={`mailto:${site.email.general}?subject=${encodeURIComponent(p.data.title + ' enquiry')}`}>{p.data.enquire ?? 'Enquire about licensing'}</a>
        )}
        {p.data.links.map((l) => <a class="btn" href={l.url} rel="noopener">{l.label}</a>)}
      </div>
    </div>
  </section>
  <div class="wrap with-side">
    <article class="prose"><Content /></article>
    <aside class="side">
      {toc.length > 1 && (
        <div class="card">
          <h4>On this page</h4>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </div>
      )}
      {docs.length > 0 && (
        <div class="card">
          <h4>Documentation</h4>
          <ul>{docs.map((d) => <li><a href={docUrl(d)}>{d.data.title}</a></li>)}</ul>
        </div>
      )}
      {apps.length > 0 && (
        <div class="card">
          <h4>Apps</h4>
          <ul>{apps.map((a) => <li><a href={appUrl(a.id)}>{a.data.name}</a></li>)}</ul>
        </div>
      )}
      {p.data.tech.length > 0 && (
        <div class="card"><h4>Built with</h4><TechBadges items={p.data.tech} /></div>
      )}
      {siblings.length > 0 && (
        <div class="card">
          <h4>Related</h4>
          <ul>{siblings.map((s) => <li><a href={projectUrl(s)}>{s.data.title}</a></li>)}</ul>
        </div>
      )}
    </aside>
  </div>
</Base>
