---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import TechBadges from '../../../components/TechBadges.astro';
import { getGroups, getProjects } from '../../../lib/content';

export async function getStaticPaths() {
  const groups = await getGroups();
  return groups.map((group) => ({ params: { group: group.id }, props: { group } }));
}
const { group } = Astro.props;
const projects = await getProjects(group.id);
const { Content } = await render(group);
---
<Base title={group.data.title} description={group.data.summary}>
  <section class="hero">
    <div class="wrap">
      <div class="crumbs"><a href="/projects/">Projects</a> / {group.data.title}</div>
      <h1>{group.data.title}</h1>
      <p class="lead">{group.data.summary}</p>
      <TechBadges items={group.data.tech} />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      <div class="prose" style="margin-top:2.5rem"><Content /></div>
    </div>
  </section>
</Base>
